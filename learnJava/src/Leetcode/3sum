class Solution {
    public void insertionSort(int[] arr) {
        int n = arr.length;
        for (int i = 1; i < n; i++) {
            int key = arr[i];
            int j = i - 1;
            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j = j - 1;
            }
            arr[j + 1] = key;
        }
    }
    public List<List<Integer>> threeSum(int[] a) {
        List<List<Integer>> list = new ArrayList<>();
        int n = a.length;

        insertionSort(a);
        for (i=0; i<=n-3;i++){
            if (i>0 && a[i]==a[i-1]) continue;
            if (a[i] + a[i+1] + a[i+2] > 0) break;
            s=0-a[i];
            l=i+1; r=n-1;
            while(l<r){
                rs=a[l]+a[r];
                if (rs==s){
                    list.add(Arrays.asList(a[i], a[l], a[r]));
                    r--;
                    l++;
                    while (l < r && a[l] == a[l-1])l++;
                    while (l < r && a[r] == a[r+1])r--;
                }
            
                else if (rs>s) r--;
                else l++ ;

            }
            
        }

        




        
    }
}